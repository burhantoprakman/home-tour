# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Modal (GPU pipeline)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# CDN that serves room_lod/lod-meta.json (+ chunks) / collision.glb
NEXT_PUBLIC_CDN_BASE_URL=

# Colyseus realtime server
NEXT_PUBLIC_REALTIME_URL=ws://localhost:2567
# Shared by apps/web (signs join tickets) and apps/realtime (checks them). 32+ random chars,
# e.g. `openssl rand -hex 32`.
REALTIME_TICKET_SECRET=

# Viewer dev page only: extra absolute folders it may load splats from (comma-separated).
VIEWER_FS_ALLOW=
